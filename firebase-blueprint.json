{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Public profile record for a verified Google / KITEST user",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 1,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Display name from Google account",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL from Google account",
          "maxLength": 1024
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last sign-in"
        }
      },
      "required": ["uid", "displayName", "updatedAt"]
    }
  },
  "firestore": {
    "/users_public/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public verified Google sign-in profiles"
    }
  }
}
