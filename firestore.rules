rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'updatedAt']) &&
             data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             data.updatedAt is string && data.updatedAt.size() >= 10 && data.updatedAt.size() <= 64;
    }

    match /users_public/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId) && isOwner(userId) && isValidUserPublicProfile(request.resource.data, userId);
      allow update: if isValidId(userId) && isOwner(userId) &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']) &&
                    isValidUserPublicProfile(request.resource.data, userId);
      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
